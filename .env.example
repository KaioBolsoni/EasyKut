# ==============================================================================
# Configurações de Ambiente do EasyKut Studio V3.1
# ==============================================================================
# Copie este arquivo para `cortador_automatico/.env` e preencha suas chaves.
# IMPORTANTE: Nunca versionar o arquivo `.env` nem manter cópias redundantes
# (como `APIS.txt` ou `.env`) fora de `cortador_automatico/`.

# Chave da API Groq (obrigatória para transcrição Whisper e fallback LLM)
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=gsk_sua_chave_groq_aqui

# Chave da API Google Gemini (recomendada como provedor principal de curadoria)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_sua_chave_gemini_aqui

# Caminho opcional para arquivo cookies.txt (formato Netscape) para vídeos com
# restrição de login/bot-check no YouTube. Se omitido, o sistema busca
# automaticamente `cortador_automatico/cookies.txt`.
# YOUTUBE_COOKIES_PATH=C:\caminho\para\cookies.txt

# Observação sobre yt-dlp + YouTube EJS:
# Para resolução de desafios JS do YouTube, mantenha o runtime Deno instalado
# em `%USERPROFILE%\.deno\bin\deno.exe` (adicionado automaticamente ao PATH
# pelo `iniciar_easykut.bat`).
